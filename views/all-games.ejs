<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Games - Checkpoint</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <h1>All Games</h1>

    <form action="/games" method="GET" class="search-bar">
        <input type="text" name="search" placeholder="Search for a game..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        <button type="submit">Search</button>
        <a href="/games"><button type="button">All Games</button></a>
    </form>

    <% if (games && games.length === 0) { %>
        <p style="text-align: center; margin-top: 2rem;">No games found. Try searching for another title!</p>
    <% } %>

    <ul>
        <% games.forEach(game => { %>
            <li>
                <a href="/games/<%= game.rawgId || game._id %>">
                    <% if (game.coverImage) { %>
                        <img src="<%= game.coverImage %>" alt="<%= game.title %>">
                    <% } %>
                    <h3><%= game.title %></h3>
                </a>
            </li>
        <% }) %>
    </ul>
</body>
</html>