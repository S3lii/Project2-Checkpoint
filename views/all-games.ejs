<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Games - Checkpoint</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <h1>All Games</h1>

    <ul>
        <% games.forEach(game => { %>
            <li>
             <a href="/games/<%= game.rawgId || game._id %>">
            <% if (game.coverImage) { %>
             <img src="<%= game.coverImage %>" alt="<%= game.title %>">
            <% } %>
             <h3><%= game.title %></h3>
            </a>
            </li>
        <% }) %>
    </ul>
</body>
</html>