<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkpoint - Home</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="homepage-body">
    <%- include('partials/navbar') %>

    <h1>Welcome To Checkpoint</h1>
    <p>Your First Destination For Games 🎮</p>

    <div class="home-buttons">
        <a href="/games"><button>Browse All Games</button></a>
        <% if (user) { %>
            <a href="/games/my-games"><button>My Games</button></a>
        <% } else { %>
            <a href="/auth/sign-up"><button>Create Account</button></a>
        <% } %>
    </div>
</body>
</html>