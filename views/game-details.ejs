<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= game.title %> - Details</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <h1>Game Details</h1>
    <h2><%= game.title %></h2>

    <% if (game.coverImage) { %>
        <img src="<%= game.coverImage %>" alt="<%= game.title %>" width="300">
        <br><br>
    <% } %>

    <p><strong>Description:</strong> <%= game.description || 'No description provided.' %></p>

    <hr>

    <% if (user) { %>
        <h3>Rate & Review This Game</h3>

        <form action="/games/<%= game._id %>/reviews" method="POST">
            <label for="rating">Score Rating (1-5):</label>
            <select name="rating" id="rating" required>
                <option value="5">⭐⭐⭐⭐⭐ (5 - Masterpiece)</option>
                <option value="4" selected>⭐⭐⭐⭐ (4 - Great)</option>
                <option value="3">⭐⭐⭐ (3 - Decent)</option>
                <option value="2">⭐⭐ (2 - Subpar)</option>
                <option value="1">⭐ (1 - Terrible)</option>
            </select>
            <br><br>

            <label for="difficulty">Difficulty:</label>
            <select name="difficulty" id="difficulty" required>
                <option value="Easy">Easy</option>
                <option value="Medium" selected>Medium</option>
                <option value="Hard">Hard</option>
                <option value="Nightmare">Nightmare</option>
            </select>
            <br><br>

            <label for="played">I have played this game: </label>
            <input type="checkbox" name="played" id="played" checked>
            <br><br>

            <label for="completed">I have completed this game: </label>
            <input type="checkbox" name="completed" id="completed">
            <br><br>

            <label for="comment">Your Review / Comment:</label>
            <br>
            <textarea name="comment" id="comment" rows="4" cols="40" placeholder="Write your thoughts..."></textarea>
            <br><br>

            <button type="submit">Submit Review</button>
        </form>
    <% } else { %>
        <p><a href="/auth/sign-in">Sign in</a> to rate or review this game.</p>
    <% } %>

    <hr>

    <h2>Player Reviews (<%= game.reviews ? game.reviews.length : 0 %>)</h2>

    <% if (game.reviews && game.reviews.length > 0) { %>
        <ul>
            <% game.reviews.forEach(review => { %>
                <li>
                    <p><strong><%= review.username %></strong> rated this: <%= review.rating %> / 5 ⭐</p>
                    <p><strong>Difficulty:</strong> <%= review.difficulty %></p>
                    <p><strong>Played:</strong> <%= review.played ? 'Yes' : 'No' %> | <strong>Completed:</strong> <%= review.completed ? 'Yes' : 'No' %></p>
                    
                    <% if (review.comment) { %>
                        <p><em>"<%= review.comment %>"</em></p>
                    <% } %>

                    <% if (user && review.user.equals(user._id)) { %>
                        <a href="/games/<%= game._id %>/reviews/<%= review._id %>/edit">Edit</a>
                        |
                        <form action="/games/<%= game._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" style="display:inline;">
                            <button type="submit" onclick="return confirm('Delete review?');">Delete</button>
                        </form>
                    <% } %>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No player reviews yet. Be the first to review this game!</p>
    <% } %>

    <br>
    <a href="/games">Back to All Games</a>
</body>
</html>